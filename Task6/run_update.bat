@echo off
chcp 65001 > nul
echo ========================================
echo Запуск обновления векторного индекса
echo Время: %date% %time%
echo ========================================

REM Устанавливаем переменные окружения
set PYTHONPATH=.

REM Запускаем Python скрипт
python update_index.py

REM Проверяем код возврата
if errorlevel 1 (
    echo ОШИБКА: Обновление завершилось с ошибкой!
    exit /b 1
) else (
    echo УСПЕХ: Обновление завершено успешно!
    exit /b 0
)